# Kept local, not published: unit tests and equivalence checks against the previous
# project, and internal planning/report documents. Run commands are documented in
# README.md instead of wrapper scripts.
/tests/
/scripts/
/docs/

# Local machine configuration (copy configs/paths.example.yaml)
/configs/paths.yaml
.env
.env.*

# Large artifacts live outside the repository (root-anchored: package folders such as
# src/wvad/features/ must stay tracked)
/outputs/
/runs/
/checkpoints/
/features/
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.pkl
*.h5
*.mp4
*.avi
*.zip
*.tgz
*.tar.gz
!tests/fixtures/**

# Experiment raw logs (plans, summaries and small CSV/JSON results are tracked)
experiments/**/logs/
experiments/**/scratch/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
/dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.venv/
venv/

# Manuscript and its figure / number generators: kept local until submission
# (user 2026-10-21); only paper/README.md is tracked
/paper/*
!/paper/README.md
/src/wvad/paper/

# Editors / OS / local agent state
.vscode/
.idea/
.DS_Store
Thumbs.db
.omc/
.claude/
/DEPLOYED_COMMIT
